---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import { profile, featuredProjects, highlights } from "../site-content";
import { path, resolveUrl } from "../lib/paths";
---

<BaseLayout sideBarActiveItemID="home">
  <div class="pb-12 mt-5">
    <div class="text-xl py-1">{profile.greeting}</div>
    <div class="text-5xl font-bold">我是 {profile.name}</div>
    <div class="text-3xl py-3 font-bold">{profile.tagline}</div>
    <div class="py-2">
      <p class="text-lg whitespace-pre-line">{profile.bio}</p>
    </div>
    <div class="mt-8 flex flex-wrap gap-3">
      <a class="btn" href={profile.github} target="_blank" rel="noopener"> GitHub </a>
      <a href={path("internship")} class="btn btn-outline"> 实习经历 </a>
      <a href={path("cv")} class="btn btn-outline"> 完整简历 </a>
      {
        profile.email && (
          <a href={`mailto:${profile.email}`} class="btn btn-outline">
            联系我
          </a>
        )
      }
    </div>
  </div>

  <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-10">
    {
      highlights.map((item) => (
        <div class="rounded-lg bg-base-200 p-4 text-center">
          <div class="text-2xl font-bold text-primary">{item.value}</div>
          <div class="text-sm opacity-70">{item.label}</div>
        </div>
      ))
    }
  </div>

  <div>
    <div class="text-3xl w-full font-bold mb-2">精选项目 {"</>"}</div>
  </div>

  {
    featuredProjects.map((project, index) => (
      <>
        <HorizontalCard
          title={project.title}
          desc={project.desc}
          url={resolveUrl(project.url || "projects")}
          badge={project.badge}
          target={project.url ? "_blank" : "_self"}
        />
        {index < featuredProjects.length - 1 && <div class="divider my-0" />}
      </>
    ))
  }

  <div class="mt-10">
    <a href={path("projects")} class="btn btn-outline">查看全部项目 →</a>
  </div>
</BaseLayout>
