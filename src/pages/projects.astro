---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import { allProjects } from "../site-content";
import { resolveUrl } from "../lib/paths";
---

<BaseLayout title="Projects" sideBarActiveItemID="projects">
  <div>
    <div class="text-3xl w-full font-bold mb-2">项目经验</div>
    <p class="mb-5 opacity-80">个人开源项目与团队竞赛/双创项目</p>
  </div>

  {
    allProjects.map((project, index) => (
      <>
        <HorizontalCard
          title={project.title}
          desc={project.desc}
          url={resolveUrl(project.url || "#")}
          badge={project.badge}
          target={project.url ? "_blank" : "_self"}
        />
        {index < allProjects.length - 1 && <div class="divider my-0" />}
      </>
    ))
  }
</BaseLayout>
