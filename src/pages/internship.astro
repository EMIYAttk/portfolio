---
import BaseLayout from "../layouts/BaseLayout.astro";
import { internshipIntro, internships } from "../site-content";
---

<BaseLayout title="实习经历" sideBarActiveItemID="internship">
  <div class="mb-6">
    <div class="text-3xl w-full font-bold mb-3">{internshipIntro.title}</div>
    <p class="text-justify whitespace-pre-line opacity-90 leading-relaxed">
      {internshipIntro.summary}
    </p>
  </div>

  <div class="space-y-8">
    {
      internships.map((item, index) => (
        <article class="rounded-xl border border-base-300 bg-base-100 p-6 shadow-sm">
          <div class="flex flex-wrap items-start justify-between gap-2 mb-4">
            <div>
              <span class="badge badge-primary badge-outline mb-2">实习 {index + 1}</span>
              <h2 class="text-2xl font-bold">{item.title}</h2>
              <p class="text-sm opacity-70 mt-1">{item.subtitle}</p>
            </div>
          </div>

          <div class="flex flex-wrap gap-2 mb-5">
            {item.techStack.map((tech) => (
              <span class="badge badge-ghost">{tech}</span>
            ))}
          </div>

          <div class="space-y-4">
            <section>
              <h3 class="font-semibold text-primary mb-1">场景需求</h3>
              <p class="text-justify text-sm leading-relaxed">{item.scenario}</p>
            </section>
            <section>
              <h3 class="font-semibold text-primary mb-1">解决思路</h3>
              <p class="text-justify text-sm leading-relaxed">{item.approach}</p>
            </section>
            <section>
              <h3 class="font-semibold text-primary mb-1">主要贡献</h3>
              <ul class="list-disc ml-5 space-y-1.5 text-sm">
                {item.contributions.map((point) => (
                  <li class="leading-relaxed">{point}</li>
                ))}
              </ul>
            </section>
          </div>
        </article>
      ))
    }
  </div>
</BaseLayout>
